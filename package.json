{
  "name": "mesasays-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "data:check": "node scripts/validate-restaurant-data.mjs",
    "data:open": "node scripts/open-data-to-v1.mjs",
    "prebuild": "npm run data:check",
    "build": "next build",
    "build:server": "npm run data:check && MESASAYS_TARGET=server next build",
    "build:ipfs": "node scripts/build-ipfs.mjs",
    "start": "next start",
    "lint": "eslint",
    "menus:check": "node scripts/check-menu-sources.mjs",
    "menus:test": "node --test scripts/check-menu-sources.test.mjs scripts/import-wave.test.mjs && node scripts/test-menu-publication.mjs"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "1.59.0",
    "@farcaster/core": "0.20.0",
    "@noble/curves": "1.9.1",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/extensions": "2.28.0",
    "@x402/next": "2.28.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "viem": "^2.57.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/mesasays/mesasays-site"
  }
}
