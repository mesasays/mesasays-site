# Public URL of your deployment (used for canonical links, sitemaps, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Say (community threads). Optional: without these, Say pages show an error and the guide still works.
# Use your own Supabase project with supabase/say/20261027000000_say.sql applied.
# Only the PUBLISHABLE key goes here: it can read published posts and call say_post / say_reply, nothing else.
SAY_SUPABASE_URL=
SAY_SUPABASE_PUBLISHABLE_KEY=
